# Reference list only: the backend does NOT read .env files.
# Set each variable in every PowerShell terminal that runs the server or CLI,
# for example: $env:BRIEFING_MODE = "live". Never commit real keys.

# Runtime (defaults: demo, fixture, .briefing-data)
BRIEFING_MODE=
BRIEFING_CORPUS=
BRIEFING_DATA_DIR=
BRIEFING_PROFILES=
# BRIEFING_MULTILINGUAL=0 offers English only; German and Dutch are on by default
BRIEFING_MULTILINGUAL=
BRIEFING_SPEECH_TIMEOUT_SECONDS=

# Live providers (backend only)
ALLOW_EXTERNAL_PROVIDER_DATA=
OPENAI_API_KEY=
OPENAI_SMALL_MODEL=
OPENAI_EMBEDDING_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
BRIEFING_LIVE_BATCH_ARTICLES=
BRIEFING_LIVE_BATCH_CHARS=
BRIEFING_LIVE_ARTICLE_CHARS=
BRIEFING_LIVE_EXTRACTION_OUTPUT_TOKENS=

# Cost rates (USD); applied when the cost report is built
OPENAI_EMBEDDING_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=
ELEVENLABS_USD_PER_1000_CHARS=
