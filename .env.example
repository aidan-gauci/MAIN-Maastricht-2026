# Reference list only: the backend does NOT read .env files.
# Set each variable in every PowerShell terminal that runs the server or CLI,
# for example: $env:LIQUID_MODE = "live". Never commit real keys.

# Runtime (defaults: demo, fixture, .liquid-data)
LIQUID_MODE=
LIQUID_CORPUS=
LIQUID_DATA_DIR=
LIQUID_PROFILES=
LIQUID_MULTILINGUAL=
LIQUID_SPEECH_TIMEOUT_SECONDS=

# Live providers (backend only)
ALLOW_EXTERNAL_PROVIDER_DATA=
OPENAI_API_KEY=
OPENAI_SMALL_MODEL=
OPENAI_EMBEDDING_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
LIQUID_LIVE_BATCH_ARTICLES=
LIQUID_LIVE_BATCH_CHARS=
LIQUID_LIVE_ARTICLE_CHARS=
LIQUID_LIVE_EXTRACTION_OUTPUT_TOKENS=

# Cost rates (USD); applied when the cost report is built
OPENAI_EMBEDDING_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=
ELEVENLABS_USD_PER_1000_CHARS=
