        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const execution = $input.first().json;\nconst runData = execution.data?.resultData?.runData;\n\nif (!runData || typeof runData !== 'object') {\n  throw new Error('Failed execution data is unavailable. Enable saved error execution data in n8n.');\n}\n\nfor (const runs of Object.values(runData)) {\n  for (const run of Array.isArray(runs) ? runs : []) {\n    for (const output of run.data?.main ?? []) {\n      for (const item of output ?? []) {\n        const envelope = item.json?.body;\n        if (\n          typeof envelope?.schedule_id === 'string' &&\n          Number.isInteger(envelope.schedule_version) &&\n          typeof envelope.generation_at === 'string' &&\n          typeof envelope.delivery_at === 'string'\n        ) {\n          return [{ json: {\n            schedule_id: envelope.schedule_id,\n            schedule_version: envelope.schedule_version,\n            generation_at: envelope.generation_at,\n            delivery_at: envelope.delivery_at\n          } }];\n        }\n      }\n    }\n  }\n}\n\nthrow new Error('The failed execution did not contain a schedule envelope.');"
      },
      "id": "dcd66347-3847-43fd-9438-01dca4c75eb9",
      "name": "Extract Schedule Envelope",
